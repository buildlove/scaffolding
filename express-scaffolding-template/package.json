{
  "name": "express-scaffolding-template",
  "version": "1.0.0",
  "description": "Node.js + Express 5 后端起步模板：分层架构 + Swagger 文档 + 统一响应/错误处理 + 请求日志 + 跨域 + 静态资源",
  "type": "module",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test"
  },
  "keywords": [
    "express",
    "node",
    "scaffold",
    "template",
    "swagger"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  }
}
