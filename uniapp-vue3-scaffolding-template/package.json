{
  "name": "uniapp-vue3-scaffolding-template",
  "private": true,
  "version": "1.0.0",
  "description": "开箱即用的 uni-app Vue3 多端起步模板（Vue3 + Vite + Pinia + 请求封装）",
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
