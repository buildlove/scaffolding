    "@dcloudio/uni-h5": "3.0.0-alpha-5030720261117001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5030720261117001",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.32",
    "@dcloudio/uni-automator": "3.0.0-alpha-5030720261117001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5030720261117001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5030720261117001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030720261117001",
