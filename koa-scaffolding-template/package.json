{
  "name": "koa-scaffolding-template",
  "version": "1.0.0",
  "description": "Node.js + Koa 3 后端起步模板：分层架构 + Swagger 文档 + 统一响应/错误处理 + 请求日志 + 跨域 + 静态资源",
  "type": "module",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test"
  },
  "keywords": [
    "koa",
    "node",
    "scaffold",
    "template",
    "swagger"
  ],
  "license": "MIT",
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.1",
    "dotenv": "^18.0.10",
    "koa": "^3.3.0",
    "koa-bodyparser": "^4.4.1",
    "koa-static": "^5.0.0",
    "koa2-swagger-ui": "^5.12.0",
    "swagger-jsdoc": "^6.3.0"
  }
}
